# Copy to a secret-managed environment and replace every placeholder before starting Compose.
APP_ENV=staging
PORT=4173
PERSISTENCE_MODE=postgresql
POSTGRES_USER=raw_material_os
POSTGRES_PASSWORD=replace-with-a-secret
POSTGRES_DB=raw_material_os
STAGING_DATABASE_URL=postgresql://raw_material_os:replace-with-a-secret@postgres:5432/raw_material_os
DATABASE_URL=postgresql://raw_material_os:replace-with-a-secret@127.0.0.1:5432/raw_material_os
DATABASE_ADMIN_URL=postgresql://raw_material_os:replace-with-a-secret@127.0.0.1:5432/postgres
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=raw-material-evidence
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-secret-managed-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-a-secret-managed-secret-key
OBJECT_STORAGE_REGION=us-east-1

# These flags are evidence claims, not defaults. Set them only after the corresponding
# migration, backup, isolation, audit, authentication and reconciliation checks pass.
PERSISTENCE_SCHEMA_APPLIED=false
BACKUP_DRILL_PASSED=false
BACKUP_DRILL_EVIDENCE_REF=
TRANSACTION_ISOLATION_VERIFIED=false
AUDIT_POLICY_APPLIED=false
OBJECT_STORAGE_READY=false
EVIDENCE_STORE_READY=false
AUTH_PROVIDER_READY=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
POSTGRES_DOMAIN_ADAPTER_READY=false
POSTGRES_DOMAIN_API_READY=false
POSTGRES_DOMAIN_RECONCILIATION_VERIFIED=false
PRICE_SOURCE_APPROVED=false
PRICE_SOURCE_APPROVAL_REF=
MONITORING_CONNECTED=false
MONITORING_HEARTBEAT_VERIFIED=false
SUPERVISOR_CONNECTED=false
SUPERVISOR_HEARTBEAT_VERIFIED=false
OPS_EXTERNAL_NOTIFICATIONS_ENABLED=false
OPS_NOTIFICATION_WEBHOOK_URL=
OPS_NOTIFICATION_WEBHOOK_TOKEN=
SHADOW_PILOT_APPROVED=false
SHADOW_PILOT_APPROVAL_REF=

